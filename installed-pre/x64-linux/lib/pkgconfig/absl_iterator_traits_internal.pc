prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: absl_iterator_traits_internal
Description: Abseil iterator_traits_internal library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}"
Requires: absl_config = 20260107, absl_type_traits = 20260107
Cflags: "-I${includedir}" -DNOMINMAX
