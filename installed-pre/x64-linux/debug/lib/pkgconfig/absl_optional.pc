prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/../include

Name: absl_optional
Description: Abseil optional library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}"
Requires: absl_config = 20260107, absl_utility = 20260107
Cflags: "-I${includedir}" -DNOMINMAX
