diff --git a/vendor/hash/hash.cpp b/vendor/hash/hash.cpp
--- a/vendor/hash/hash.cpp
+++ b/vendor/hash/hash.cpp
@@ -1,8 +1,8 @@
 #include "hash.h"
 
-extern "C" {
-#include "sha256/sha256.h"
-}
+#include <openssl/evp.h>
+
+#include <stdexcept>
 
 static std::string to_hex(const unsigned char * digest, size_t len) {
     static const char hex[] = "0123456789abcdef";
@@ -17,7 +17,10 @@ static std::string to_hex(const unsigned char * digest, size_t len) {
 }
 
 std::string hash_sha256_hex(const void * data, size_t len) {
-    unsigned char digest[SHA256_DIGEST_SIZE];
-    sha256_hash(digest, (const unsigned char *) data, len);
-    return to_hex(digest, SHA256_DIGEST_SIZE);
+    unsigned char digest[EVP_MAX_MD_SIZE];
+    unsigned int digest_len = 0;
+    if (EVP_Digest(data, len, digest, &digest_len, EVP_sha256(), nullptr) != 1) {
+        throw std::runtime_error("failed to compute SHA-256 digest");
+    }
+    return to_hex(digest, digest_len);
 }
