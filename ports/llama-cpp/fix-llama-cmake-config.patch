diff --git a/cmake/llama-config.cmake.in b/cmake/llama-config.cmake.in
--- a/cmake/llama-config.cmake.in
+++ b/cmake/llama-config.cmake.in
@@ -11,10 +11,15 @@ set(LLAMA_BIN_DIR "@PACKAGE_LLAMA_BIN_INSTALL_DIR@")
 
 find_package(ggml REQUIRED HINTS ${LLAMA_LIB_DIR}/cmake)
 
-find_library(llama_LIBRARY llama
+find_library(llama_LIBRARY_RELEASE llama
     REQUIRED
-    HINTS ${LLAMA_LIB_DIR}
-    NO_CMAKE_FIND_ROOT_PATH
+    PATHS ${LLAMA_LIB_DIR}
+    NO_DEFAULT_PATH
+)
+find_library(llama_LIBRARY_DEBUG llama
+    REQUIRED
+    PATHS "${PACKAGE_PREFIX_DIR}/debug/lib"
+    NO_DEFAULT_PATH
 )
 
 if(NOT TARGET llama)
@@ -24,7 +29,11 @@ if(NOT TARGET llama)
             INTERFACE_INCLUDE_DIRECTORIES "${LLAMA_INCLUDE_DIR}"
             INTERFACE_LINK_LIBRARIES "ggml::ggml;ggml::ggml-base;"
             IMPORTED_LINK_INTERFACE_LANGUAGES "CXX"
-            IMPORTED_LOCATION "${llama_LIBRARY}"
+            IMPORTED_CONFIGURATIONS "RELEASE;DEBUG"
+            IMPORTED_LOCATION_RELEASE "${llama_LIBRARY_RELEASE}"
+            IMPORTED_LOCATION_DEBUG "${llama_LIBRARY_DEBUG}"
+            MAP_IMPORTED_CONFIG_MINSIZEREL Release
+            MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
             INTERFACE_COMPILE_FEATURES c_std_90
             POSITION_INDEPENDENT_CODE ON)
 endif()
