+macro(_ggml_find_library prefix library_name)
+    unset(${prefix}_LIBRARY_RELEASE CACHE)
+    find_library(${prefix}_LIBRARY_RELEASE ${library_name}
+        REQUIRED
+        PATHS "${GGML_LIB_DIR}"
+        NO_DEFAULT_PATH
+    )
+    unset(${prefix}_LIBRARY_DEBUG CACHE)
+    find_library(${prefix}_LIBRARY_DEBUG ${library_name}
         REQUIRED
-        HINTS ${GGML_LIB_DIR}
-        NO_CMAKE_FIND_ROOT_PATH)
-    list(APPEND GGML_CPU_INTERFACE_LINK_LIBRARIES ${KLEIDIAI_LIBRARY})
+        PATHS "${PACKAGE_PREFIX_DIR}/debug/lib"
+        NO_DEFAULT_PATH
+    )
+endmacro()
+
+macro(_ggml_set_library_configurations target prefix)
+    set_target_properties(${target}
+        PROPERTIES
+            IMPORTED_CONFIGURATIONS "RELEASE;DEBUG"
+            IMPORTED_LOCATION_RELEASE "${${prefix}_LIBRARY_RELEASE}"
+            IMPORTED_LOCATION_DEBUG "${${prefix}_LIBRARY_DEBUG}"
+            MAP_IMPORTED_CONFIG_MINSIZEREL Release
+            MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
+    )
+endmacro()
+
+if (NOT GGML_SHARED_LIB AND GGML_CPU_KLEIDIAI)
+    _ggml_find_library(KLEIDIAI kleidiai)
+    list(APPEND GGML_CPU_INTERFACE_LINK_LIBRARIES
+        debug "${KLEIDIAI_LIBRARY_DEBUG}"
+        optimized "${KLEIDIAI_LIBRARY_RELEASE}"
+    )
 endif()
 
