{
  "name": "llama-cpp",
  "version": "1.0.0",
  "description": "LLM inference in C/C++",
  "homepage": "https://github.com/ggml-org/llama.cpp",
  "license": "MIT",
  "dependencies": [
    "cpp-httplib",
    "nlohmann-json",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "xxhash"
  ],
  "default-features": [
    {
      "name": "metal",
      "platform": "osx | ios"
    }
  ],
  "features": {
    "blas": {
      "description": "Use OpenBLAS for CPU matrix operations",
      "supports": "windows | linux | osx",
      "dependencies": [
        "openblas"
      ]
    },
    "cuda": {
      "description": "Use CUDA",
      "supports": "(windows & x64 & !uwp & !xbox) | (linux & (x64 | arm64))",
      "dependencies": [
        "cuda"
      ]
    },
    "llamafile": {
      "description": "Use llamafile CPU kernels",
      "supports": "windows | linux | osx"
    },
    "metal": {
      "description": "Use Metal",
      "supports": "osx | ios"
    },
    "opencl": {
      "description": "Use OpenCL",
      "dependencies": [
        "opencl"
      ]
    },
    "openmp": {
      "description": "Use OpenMP"
    },
    "rpc": {
      "description": "Build the RPC backend",
      "supports": "windows | linux | osx"
    },
    "tools": {
      "description": "Build llama tools",
      "supports": "windows | linux | osx",
      "dependencies": [
        {
          "name": "cpp-httplib",
          "features": [
            "openssl"
          ]
        },
        "miniaudio",
        "stb"
      ]
    }
  }
}
