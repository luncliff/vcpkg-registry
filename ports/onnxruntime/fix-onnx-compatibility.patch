+    tensor.set_data_type(type);
+    tensor.add_dims(1);
+    size_t bytes = 0;
+    const auto status = GetSizeInBytesFromTensorProto<0>(tensor, &bytes);
+    EXPECT_FALSE(status.IsOK());
+    EXPECT_EQ(status.Code(), common::NOT_IMPLEMENTED);
+  }
