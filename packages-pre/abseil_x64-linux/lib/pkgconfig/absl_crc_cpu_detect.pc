prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: absl_crc_cpu_detect
Description: Abseil crc_cpu_detect library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}" -labsl_crc_cpu_detect
Requires: absl_base = 20260107, absl_config = 20260107, absl_optional = 20260107
Cflags: "-I${includedir}" -DNOMINMAX
