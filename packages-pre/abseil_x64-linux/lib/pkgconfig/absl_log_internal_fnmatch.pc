prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: absl_log_internal_fnmatch
Description: Abseil log_internal_fnmatch library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}" -labsl_log_internal_fnmatch
Requires: absl_config = 20260107, absl_strings = 20260107
Cflags: "-I${includedir}" -DNOMINMAX
