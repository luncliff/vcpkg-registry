Description: Abseil bounded_utf8_length_sequence library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}"
Requires: absl_bits = 20260107, absl_config = 20260107
Cflags: "-I${includedir}" -DNOMINMAX
