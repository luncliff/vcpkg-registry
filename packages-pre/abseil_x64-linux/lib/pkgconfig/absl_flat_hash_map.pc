prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: absl_flat_hash_map
Description: Abseil flat_hash_map library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}"
Requires: absl_container_memory = 20260107, absl_core_headers = 20260107, absl_hash_container_defaults = 20260107, absl_raw_hash_map = 20260107, absl_algorithm_container = 20260107, absl_type_traits = 20260107
Cflags: "-I${includedir}" -DNOMINMAX
