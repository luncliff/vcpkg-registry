prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: absl_scoped_set_env
Description: Abseil scoped_set_env library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}" -labsl_scoped_set_env
Requires: absl_config = 20260107, absl_raw_logging_internal = 20260107
Cflags: "-I${includedir}" -DNOMINMAX
